# Copy to .env and adjust. Values below are dev-only examples — do not reuse in production.

POSTGRES_USER=agnos
POSTGRES_PASSWORD=agnos_dev_password
POSTGRES_DB=agnos

JWT_SECRET=dev-jwt-secret-change-me
HMAC_SECRET=dev-hmac-secret-change-me

# Must be a base64-encoded 32-byte value (AES-256). Generate your own with:
#   openssl rand -base64 32
ENCRYPTION_KEY=aWLCnJtbdL/+xB1I0A+mWMwZCpiQSVUW96a7wh8WdP8=

# Enables permissive CORS (Access-Control-Allow-Origin: *) — only needed to run
# webui/ from a different origin/port. Leave unset/false for a normal deployment.
ENABLE_DEV_CORS=true
